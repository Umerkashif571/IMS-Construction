# API base URL — leave empty to use relative /api (same domain via proxy/reverse proxy)
# Set to full URL (e.g. https://api.your-domain.com) when API is on a different origin
VITE_API_URL=

# Supabase Configuration (for real-time subscriptions)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-publishable-key>
