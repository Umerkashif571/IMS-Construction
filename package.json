{
  "name": "ims-construction",
  "version": "1.0.0",
  "private": true,
  "description": "IMS Construction — Vite/React frontend (client/) + Express backend (server/), deployed to Vercel as a static site + one serverless API function.",
  "scripts": {
    "build": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "db:init": "npm --prefix server run db:init"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "serverless-http": "^4.0.0",
    "uuid": "^14.0.1"
  },
  "engines": {
    "node": "20.x"
  }
}