# Server
PORT=5000
NODE_ENV=development

# Database
# Hosted (Supabase pooler): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local Postgres without TLS:  postgresql://postgres:postgres@localhost:5432/ims_db?sslmode=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ims_db?sslmode=disable

# Supabase (for realtime subscriptions and auth)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<rotate-and-set-in-hosting-env-only>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# CORS - comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,https://your-production-domain.com
