{
  "version": 2,
  "regions": ["sin1"],
  "installCommand": "npm install && npm --prefix server install && npm --prefix client install",
  "buildCommand": "node build-vercel.js",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}